<mujoco model="quadruped">
  <compiler angle="radian" autolimits="true"/>

  <option timestep="0.005" gravity="0 0 -9.81"/>

  <default>
    <joint limited="true" damping="0.8" armature="0.02" stiffness="0"/>
    <geom conaffinity="1" condim="3" friction="1.0 0.1 0.1"/>
    <motor ctrllimited="true" ctrlrange="-1 1" gear="10"/>
  </default>

  <asset>
    <texture name="floor_tex" type="2d" builtin="checker"
             rgb1="0.25 0.25 0.25" rgb2="0.45 0.45 0.45" width="512" height="512"/>
    <material name="floor_mat" texture="floor_tex" texrepeat="6 6" reflectance="0.0"/>
    <material name="body_mat" rgba="0.15 0.50 0.85 1"/>
    <material name="leg_mat"  rgba="0.90 0.45 0.10 1"/>
    <material name="foot_mat" rgba="0.20 0.20 0.20 1"/>
  </asset>

  <worldbody>
    <light name="top"   pos="0 0 5"  dir="0 0 -1"  diffuse="0.8 0.8 0.8" specular="0.1 0.1 0.1"/>
    <light name="front" pos="2 0 2"  dir="-1 0 -1" diffuse="0.3 0.3 0.3"/>
    <geom name="floor" type="plane" size="20 20 0.1" material="floor_mat"/>

    <!-- Torso. Standing height calibrated so all four feet rest on the floor. -->
    <body name="torso" pos="0 0 0.278">
      <freejoint name="root"/>
      <geom name="torso_geom" type="box" size="0.13 0.07 0.035"
            material="body_mat" mass="0.8"/>
      <site name="imu" pos="0 0 0" size="0.005"/>

      <!--
        2 actuated joints per leg = 2 servos per leg on real hardware.
          shoulder : swings whole leg fore/aft   (hinge about y)
          knee     : flexes lower leg fore/aft    (hinge about y)
        BOTH joints rotate about the SAME y-axis so the leg bends in the
        plane of travel (x-z).  Lower leg is rigid past the knee.
        Standing pose: shoulder = +0.63, knee = -1.25  → diamond stance,
        foot directly beneath the hip.
      -->

      <!-- ===== FRONT-LEFT ===== -->
      <body name="FL_thigh" pos="0.11 0.08 0.0">
        <joint name="FL_shoulder" type="hinge" axis="0 1 0" range="-1.3 1.3"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.16" size="0.014" material="leg_mat" mass="0.06"/>
        <body name="FL_shin" pos="0 0 -0.16">
          <joint name="FL_knee" type="hinge" axis="0 1 0" range="-2.0 0.3"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.16" size="0.011" material="leg_mat" mass="0.04"/>
          <geom name="FL_foot" type="sphere" pos="0 0 -0.16" size="0.018" material="foot_mat" mass="0.02"/>
        </body>
      </body>

      <!-- ===== FRONT-RIGHT ===== -->
      <body name="FR_thigh" pos="0.11 -0.08 0.0">
        <joint name="FR_shoulder" type="hinge" axis="0 1 0" range="-1.3 1.3"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.16" size="0.014" material="leg_mat" mass="0.06"/>
        <body name="FR_shin" pos="0 0 -0.16">
          <joint name="FR_knee" type="hinge" axis="0 1 0" range="-2.0 0.3"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.16" size="0.011" material="leg_mat" mass="0.04"/>
          <geom name="FR_foot" type="sphere" pos="0 0 -0.16" size="0.018" material="foot_mat" mass="0.02"/>
        </body>
      </body>

      <!-- ===== REAR-LEFT ===== -->
      <body name="RL_thigh" pos="-0.11 0.08 0.0">
        <joint name="RL_shoulder" type="hinge" axis="0 1 0" range="-1.3 1.3"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.16" size="0.014" material="leg_mat" mass="0.06"/>
        <body name="RL_shin" pos="0 0 -0.16">
          <joint name="RL_knee" type="hinge" axis="0 1 0" range="-2.0 0.3"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.16" size="0.011" material="leg_mat" mass="0.04"/>
          <geom name="RL_foot" type="sphere" pos="0 0 -0.16" size="0.018" material="foot_mat" mass="0.02"/>
        </body>
      </body>

      <!-- ===== REAR-RIGHT ===== -->
      <body name="RR_thigh" pos="-0.11 -0.08 0.0">
        <joint name="RR_shoulder" type="hinge" axis="0 1 0" range="-1.3 1.3"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.16" size="0.014" material="leg_mat" mass="0.06"/>
        <body name="RR_shin" pos="0 0 -0.16">
          <joint name="RR_knee" type="hinge" axis="0 1 0" range="-2.0 0.3"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.16" size="0.011" material="leg_mat" mass="0.04"/>
          <geom name="RR_foot" type="sphere" pos="0 0 -0.16" size="0.018" material="foot_mat" mass="0.02"/>
        </body>
      </body>

    </body>
  </worldbody>

  <!-- 8 actuators = 8 real servos, 1-to-1.  Knee geared higher for support. -->
  <actuator>
    <motor name="FL_shoulder" joint="FL_shoulder" gear="10"/>
    <motor name="FL_knee"     joint="FL_knee"     gear="14"/>
    <motor name="FR_shoulder" joint="FR_shoulder" gear="10"/>
    <motor name="FR_knee"     joint="FR_knee"     gear="14"/>
    <motor name="RL_shoulder" joint="RL_shoulder" gear="10"/>
    <motor name="RL_knee"     joint="RL_knee"     gear="14"/>
    <motor name="RR_shoulder" joint="RR_shoulder" gear="10"/>
    <motor name="RR_knee"     joint="RR_knee"     gear="14"/>
  </actuator>

  <!-- Standing pose: diamond legs, feet beneath hips, feet resting on floor.
       qpos = [x y z  qw qx qy qz   (FL_sh FL_kn) (FR) (RL) (RR)] -->
  <keyframe>
    <key name="stand"
         qpos="0 0 0.278  1 0 0 0
               0.63 -1.25   0.63 -1.25
               0.63 -1.25   0.63 -1.25"/>
  </keyframe>

</mujoco>
