<mujoco model="quadruped">
  <compiler angle="radian" autolimits="true"/>

  <option timestep="0.005" gravity="0 0 -9.81"/>

  <default>
    <joint limited="true" damping="0.5" armature="0.01"/>
    <geom conaffinity="1" condim="3" friction="0.9 0.1 0.1"/>
    <motor ctrllimited="true" ctrlrange="-1 1"/>
  </default>

  <asset>
    <texture name="floor_tex" type="2d" builtin="checker" rgb1="0.3 0.3 0.3" rgb2="0.5 0.5 0.5" width="512" height="512"/>
    <material name="floor_mat" texture="floor_tex" texrepeat="4 4" reflectance="0.0"/>
    <material name="body_mat"  rgba="0.2 0.6 0.9 1"/>
    <material name="leg_mat"   rgba="0.9 0.5 0.2 1"/>
  </asset>

  <worldbody>
    <light name="top" pos="0 0 4" dir="0 0 -1" diffuse="0.9 0.9 0.9"/>
    <geom name="floor" type="plane" size="10 10 0.1" material="floor_mat" conaffinity="1"/>

    <!-- Main body -->
    <body name="torso" pos="0 0 0.25">
      <freejoint name="root"/>
      <geom name="torso_geom" type="box" size="0.12 0.08 0.04" material="body_mat" mass="0.5"/>
      <site name="imu" pos="0 0 0" size="0.01"/>

      <!-- Front-Left leg -->
      <body name="FL_hip" pos="0.10 0.07 0.0">
        <joint name="FL_hip_joint" type="hinge" axis="0 1 0" range="-0.8 0.8"/>
        <geom name="FL_hip_geom" type="capsule" fromto="0 0 0 0 0 -0.05" size="0.015" material="leg_mat" mass="0.05"/>
        <body name="FL_thigh" pos="0 0 -0.05">
          <joint name="FL_thigh_joint" type="hinge" axis="1 0 0" range="-1.2 1.2"/>
          <geom name="FL_thigh_geom" type="capsule" fromto="0 0 0 0 0 -0.08" size="0.012" material="leg_mat" mass="0.08"/>
          <body name="FL_calf" pos="0 0 -0.08">
            <joint name="FL_calf_joint" type="hinge" axis="1 0 0" range="-1.5 0.1"/>
            <geom name="FL_calf_geom" type="capsule" fromto="0 0 0 0 0 -0.08" size="0.010" material="leg_mat" mass="0.06"/>
            <geom name="FL_foot" type="sphere" pos="0 0 -0.08" size="0.015" conaffinity="1" mass="0.02"/>
          </body>
        </body>
      </body>

      <!-- Front-Right leg -->
      <body name="FR_hip" pos="0.10 -0.07 0.0">
        <joint name="FR_hip_joint" type="hinge" axis="0 1 0" range="-0.8 0.8"/>
        <geom name="FR_hip_geom" type="capsule" fromto="0 0 0 0 0 -0.05" size="0.015" material="leg_mat" mass="0.05"/>
        <body name="FR_thigh" pos="0 0 -0.05">
          <joint name="FR_thigh_joint" type="hinge" axis="1 0 0" range="-1.2 1.2"/>
          <geom name="FR_thigh_geom" type="capsule" fromto="0 0 0 0 0 -0.08" size="0.012" material="leg_mat" mass="0.08"/>
          <body name="FR_calf" pos="0 0 -0.08">
            <joint name="FR_calf_joint" type="hinge" axis="1 0 0" range="-1.5 0.1"/>
            <geom name="FR_calf_geom" type="capsule" fromto="0 0 0 0 0 -0.08" size="0.010" material="leg_mat" mass="0.06"/>
            <geom name="FR_foot" type="sphere" pos="0 0 -0.08" size="0.015" conaffinity="1" mass="0.02"/>
          </body>
        </body>
      </body>

      <!-- Rear-Left leg -->
      <body name="RL_hip" pos="-0.10 0.07 0.0">
        <joint name="RL_hip_joint" type="hinge" axis="0 1 0" range="-0.8 0.8"/>
        <geom name="RL_hip_geom" type="capsule" fromto="0 0 0 0 0 -0.05" size="0.015" material="leg_mat" mass="0.05"/>
        <body name="RL_thigh" pos="0 0 -0.05">
          <joint name="RL_thigh_joint" type="hinge" axis="1 0 0" range="-1.2 1.2"/>
          <geom name="RL_thigh_geom" type="capsule" fromto="0 0 0 0 0 -0.08" size="0.012" material="leg_mat" mass="0.08"/>
          <body name="RL_calf" pos="0 0 -0.08">
            <joint name="RL_calf_joint" type="hinge" axis="1 0 0" range="-1.5 0.1"/>
            <geom name="RL_calf_geom" type="capsule" fromto="0 0 0 0 0 -0.08" size="0.010" material="leg_mat" mass="0.06"/>
            <geom name="RL_foot" type="sphere" pos="0 0 -0.08" size="0.015" conaffinity="1" mass="0.02"/>
          </body>
        </body>
      </body>

      <!-- Rear-Right leg -->
      <body name="RR_hip" pos="-0.10 -0.07 0.0">
        <joint name="RR_hip_joint" type="hinge" axis="0 1 0" range="-0.8 0.8"/>
        <geom name="RR_hip_geom" type="capsule" fromto="0 0 0 0 0 -0.05" size="0.015" material="leg_mat" mass="0.05"/>
        <body name="RR_thigh" pos="0 0 -0.05">
          <joint name="RR_thigh_joint" type="hinge" axis="1 0 0" range="-1.2 1.2"/>
          <geom name="RR_thigh_geom" type="capsule" fromto="0 0 0 0 0 -0.08" size="0.012" material="leg_mat" mass="0.08"/>
          <body name="RR_calf" pos="0 0 -0.08">
            <joint name="RR_calf_joint" type="hinge" axis="1 0 0" range="-1.5 0.1"/>
            <geom name="RR_calf_geom" type="capsule" fromto="0 0 0 0 0 -0.08" size="0.010" material="leg_mat" mass="0.06"/>
            <geom name="RR_foot" type="sphere" pos="0 0 -0.08" size="0.015" conaffinity="1" mass="0.02"/>
          </body>
        </body>
      </body>

    </body>
  </worldbody>

  <actuator>
    <!-- FL -->
    <motor name="FL_hip"   joint="FL_hip_joint"   gear="10"/>
    <motor name="FL_thigh" joint="FL_thigh_joint" gear="15"/>
    <!-- FR -->
    <motor name="FR_hip"   joint="FR_hip_joint"   gear="10"/>
    <motor name="FR_thigh" joint="FR_thigh_joint" gear="15"/>
    <!-- RL -->
    <motor name="RL_hip"   joint="RL_hip_joint"   gear="10"/>
    <motor name="RL_thigh" joint="RL_thigh_joint" gear="15"/>
    <!-- RR -->
    <motor name="RR_hip"   joint="RR_hip_joint"   gear="10"/>
    <motor name="RR_thigh" joint="RR_thigh_joint" gear="15"/>
  </actuator>

</mujoco>
