<mujoco model="quadruped_v2">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.005" gravity="0 0 -9.81"/>

  <visual>
    <global offwidth="1280" offheight="720"/>
    <quality shadowsize="4096"/>
    <headlight diffuse="0.35 0.35 0.4" ambient="0.25 0.25 0.3" specular="0.2 0.2 0.2"/>
    <map fogstart="3" fogend="8"/>
  </visual>

  <default>
    <joint limited="true" damping="0.8" armature="0.02" stiffness="0"/>
    <geom conaffinity="1" condim="3" friction="1.0 0.1 0.1"/>
    <motor ctrllimited="true" ctrlrange="-1 1" gear="10"/>
    <!-- decorative geoms: no collision, no mass -->
    <default class="deco">
      <geom contype="0" conaffinity="0" mass="0" group="1"/>
    </default>
  </default>

  <asset>
    <texture name="sky" type="skybox" builtin="gradient"
             rgb1="0.10 0.12 0.16" rgb2="0.02 0.02 0.04" width="256" height="256"/>
    <texture name="floor_tex" type="2d" builtin="checker"
             rgb1="0.16 0.17 0.20" rgb2="0.10 0.11 0.13" width="512" height="512"/>
    <material name="floor_mat" texture="floor_tex" texrepeat="8 8"
              reflectance="0.15" shininess="0.3"/>
    <!-- robot materials: dark metallic chassis + glowing accents -->
    <material name="chassis"  rgba="0.16 0.18 0.22 1" specular="0.9" shininess="0.85" reflectance="0.25"/>
    <material name="chassis2" rgba="0.26 0.28 0.33 1" specular="0.8" shininess="0.7"  reflectance="0.2"/>
    <material name="accent"   rgba="0.00 0.85 1.00 1" specular="1.0" shininess="1.0" emission="0.35"/>
    <material name="accent_o" rgba="1.00 0.55 0.10 1" specular="0.9" shininess="0.8" emission="0.20"/>
    <material name="eye"      rgba="0.30 1.00 1.00 1" emission="0.95" specular="1.0" shininess="1.0"/>
    <material name="servo"    rgba="0.38 0.40 0.45 1" specular="0.9" shininess="0.8" reflectance="0.2"/>
    <material name="foot_mat" rgba="0.07 0.07 0.08 1" specular="0.3" shininess="0.2"/>
  </asset>

  <worldbody>
    <light name="key"  pos="1.5 -1 3" dir="-0.5 0.3 -1" diffuse="0.9 0.9 0.9" specular="0.4 0.4 0.4"/>
    <light name="fill" pos="-2 1 2"  dir="1 -0.5 -1"  diffuse="0.35 0.4 0.5"/>
    <light name="rim"  pos="-1 -2 1" dir="0.5 1 -0.5" diffuse="0.2 0.3 0.4"/>
    <geom name="floor" type="plane" size="30 30 0.1" material="floor_mat"/>

    <!-- ============================ CHASSIS ============================ -->
    <body name="torso" pos="0 0 0.278">
      <freejoint name="root"/>
      <!-- functional collision body (drives physics) -->
      <geom name="torso_geom" type="box" size="0.13 0.07 0.035" material="chassis" mass="0.8"/>
      <site name="imu" pos="0 0 0" size="0.005"/>

      <!-- decorative shell: layered plates for a mechanical look -->
      <geom class="deco" type="box" pos="0 0 0.030" size="0.115 0.062 0.012" material="chassis2"/>
      <geom class="deco" type="box" pos="0 0 0.044" size="0.07 0.045 0.010" material="chassis"/>
      <!-- glowing spine strip -->
      <geom class="deco" type="box" pos="0 0 0.052" size="0.085 0.008 0.004" material="accent"/>
      <!-- side accent rails -->
      <geom class="deco" type="box" pos="0 0.071 0.0"  size="0.12 0.004 0.018" material="accent"/>
      <geom class="deco" type="box" pos="0 -0.071 0.0" size="0.12 0.004 0.018" material="accent"/>
      <!-- rear status light -->
      <geom class="deco" type="sphere" pos="-0.11 0 0.05" size="0.012" material="accent_o"/>

      <!-- ============ HEAD MODULE (front) ============ -->
      <body name="head" pos="0.15 0 0.02">
        <geom class="deco" type="box" pos="0 0 0" size="0.035 0.05 0.035" material="chassis"/>
        <geom class="deco" type="box" pos="0.02 0 0.015" size="0.02 0.052 0.022" material="chassis2"/>
        <!-- visor / eye -->
        <geom class="deco" type="cylinder" fromto="0.045 -0.035 0.012 0.045 0.035 0.012"
              size="0.014" material="eye"/>
        <!-- antennae -->
        <geom class="deco" type="capsule" fromto="0 0.035 0.03 0.005 0.05 0.075" size="0.0035" material="servo"/>
        <geom class="deco" type="capsule" fromto="0 -0.035 0.03 0.005 -0.05 0.075" size="0.0035" material="servo"/>
        <geom class="deco" type="sphere" pos="0.005 0.05 0.078" size="0.006" material="accent"/>
        <geom class="deco" type="sphere" pos="0.005 -0.05 0.078" size="0.006" material="accent_o"/>
      </body>

      <!-- ================= LEGS: 3 joints each (hip / shoulder / knee) ================= -->
      <!-- hip = sideways abduction (axis x) → enables TURNING -->

      <!-- FRONT-LEFT -->
      <body name="FL_hip" pos="0.11 0.08 0.0">
        <joint name="FL_hip" type="hinge" axis="1 0 0" range="-0.6 0.6"/>
        <geom name="FL_hipgeom" type="cylinder" fromto="0 -0.018 0 0 0.030 0" size="0.022" material="servo" mass="0.05"/>
        <body name="FL_thigh" pos="0 0.02 0.0">
          <joint name="FL_shoulder" type="hinge" axis="0 1 0" range="-1.3 1.3"/>
          <geom type="box" pos="0 0 -0.08" size="0.018 0.012 0.082" material="chassis2" mass="0.06"/>
          <geom class="deco" type="box" pos="0.012 0 -0.05" size="0.004 0.013 0.03" material="accent"/>
          <body name="FL_shin" pos="0 0 -0.16">
            <joint name="FL_knee" type="hinge" axis="0 1 0" range="-2.0 0.3"/>
            <geom type="capsule" fromto="0 0 0 0 0 -0.16" size="0.011" material="chassis" mass="0.04"/>
            <geom name="FL_foot" type="sphere" pos="0 0 -0.16" size="0.022" material="foot_mat" mass="0.02"/>
          </body>
        </body>
      </body>

      <!-- FRONT-RIGHT -->
      <body name="FR_hip" pos="0.11 -0.08 0.0">
        <joint name="FR_hip" type="hinge" axis="1 0 0" range="-0.6 0.6"/>
        <geom name="FR_hipgeom" type="cylinder" fromto="0 -0.030 0 0 0.018 0" size="0.022" material="servo" mass="0.05"/>
        <body name="FR_thigh" pos="0 -0.02 0.0">
          <joint name="FR_shoulder" type="hinge" axis="0 1 0" range="-1.3 1.3"/>
          <geom type="box" pos="0 0 -0.08" size="0.018 0.012 0.082" material="chassis2" mass="0.06"/>
          <geom class="deco" type="box" pos="0.012 0 -0.05" size="0.004 0.013 0.03" material="accent"/>
          <body name="FR_shin" pos="0 0 -0.16">
            <joint name="FR_knee" type="hinge" axis="0 1 0" range="-2.0 0.3"/>
            <geom type="capsule" fromto="0 0 0 0 0 -0.16" size="0.011" material="chassis" mass="0.04"/>
            <geom name="FR_foot" type="sphere" pos="0 0 -0.16" size="0.022" material="foot_mat" mass="0.02"/>
          </body>
        </body>
      </body>

      <!-- REAR-LEFT -->
      <body name="RL_hip" pos="-0.11 0.08 0.0">
        <joint name="RL_hip" type="hinge" axis="1 0 0" range="-0.6 0.6"/>
        <geom name="RL_hipgeom" type="cylinder" fromto="0 -0.018 0 0 0.030 0" size="0.022" material="servo" mass="0.05"/>
        <body name="RL_thigh" pos="0 0.02 0.0">
          <joint name="RL_shoulder" type="hinge" axis="0 1 0" range="-1.3 1.3"/>
          <geom type="box" pos="0 0 -0.08" size="0.018 0.012 0.082" material="chassis2" mass="0.06"/>
          <geom class="deco" type="box" pos="-0.012 0 -0.05" size="0.004 0.013 0.03" material="accent_o"/>
          <body name="RL_shin" pos="0 0 -0.16">
            <joint name="RL_knee" type="hinge" axis="0 1 0" range="-2.0 0.3"/>
            <geom type="capsule" fromto="0 0 0 0 0 -0.16" size="0.011" material="chassis" mass="0.04"/>
            <geom name="RL_foot" type="sphere" pos="0 0 -0.16" size="0.022" material="foot_mat" mass="0.02"/>
          </body>
        </body>
      </body>

      <!-- REAR-RIGHT -->
      <body name="RR_hip" pos="-0.11 -0.08 0.0">
        <joint name="RR_hip" type="hinge" axis="1 0 0" range="-0.6 0.6"/>
        <geom name="RR_hipgeom" type="cylinder" fromto="0 -0.030 0 0 0.018 0" size="0.022" material="servo" mass="0.05"/>
        <body name="RR_thigh" pos="0 -0.02 0.0">
          <joint name="RR_shoulder" type="hinge" axis="0 1 0" range="-1.3 1.3"/>
          <geom type="box" pos="0 0 -0.08" size="0.018 0.012 0.082" material="chassis2" mass="0.06"/>
          <geom class="deco" type="box" pos="-0.012 0 -0.05" size="0.004 0.013 0.03" material="accent_o"/>
          <body name="RR_shin" pos="0 0 -0.16">
            <joint name="RR_knee" type="hinge" axis="0 1 0" range="-2.0 0.3"/>
            <geom type="capsule" fromto="0 0 0 0 0 -0.16" size="0.011" material="chassis" mass="0.04"/>
            <geom name="RR_foot" type="sphere" pos="0 0 -0.16" size="0.022" material="foot_mat" mass="0.02"/>
          </body>
        </body>
      </body>

    </body>
  </worldbody>

  <!-- 12 actuators = 12 servos (3 per leg): hip (turn) + shoulder + knee -->
  <actuator>
    <motor name="FL_hip" joint="FL_hip" gear="8"/>
    <motor name="FL_shoulder" joint="FL_shoulder" gear="10"/>
    <motor name="FL_knee" joint="FL_knee" gear="14"/>
    <motor name="FR_hip" joint="FR_hip" gear="8"/>
    <motor name="FR_shoulder" joint="FR_shoulder" gear="10"/>
    <motor name="FR_knee" joint="FR_knee" gear="14"/>
    <motor name="RL_hip" joint="RL_hip" gear="8"/>
    <motor name="RL_shoulder" joint="RL_shoulder" gear="10"/>
    <motor name="RL_knee" joint="RL_knee" gear="14"/>
    <motor name="RR_hip" joint="RR_hip" gear="8"/>
    <motor name="RR_shoulder" joint="RR_shoulder" gear="10"/>
    <motor name="RR_knee" joint="RR_knee" gear="14"/>
  </actuator>

  <!-- Standing pose: hips neutral, diamond legs, feet on floor.
       qpos = [x y z  qw qx qy qz   (FL_hip FL_sh FL_kn) (FR) (RL) (RR)] -->
  <keyframe>
    <key name="stand"
         qpos="0 0 0.278  1 0 0 0
               0 0.63 -1.25   0 0.63 -1.25
               0 0.63 -1.25   0 0.63 -1.25"/>
  </keyframe>

</mujoco>
